// GEO app database. Lives ONLY in the "geo" schema of the OneInbox Supabase project.
// Every row (except Session/Job/ApiCost platform rows) belongs to one shop via shopId.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Supabase (OneInbox project), "geo" schema only. See .env.example
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Shopify login sessions (managed by the Shopify library).
model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model Shop {
  id                String         @id @default(cuid())
  domain            String         @unique // my-store.myshopify.com
  name              String?
  email             String?
  primaryDomain     String? // www.mystore.com.au
  currency          String         @default("AUD")
  country           String         @default("AU")
  plan              String         @default("free") // free | core | pro
  status            String         @default("installed") // installed | uninstalled
  onboarding        String         @default("new") // new | profiling | questions | scanning | done
  installedAt       DateTime       @default(now())
  uninstalledAt     DateTime?
  baselineDate      DateTime?
  freeScanUsedAt    DateTime?
  lastScanAt        DateTime?
  lastReportAt      DateTime?
  autopilot         Boolean        @default(false)
  autopilotOptOut   Boolean        @default(false) // the store switched autopilot off: keep it off across plan changes
  trialEndsAt       DateTime? // end of the store's one free trial, saved when it first starts (never cleared)
  devStore          Boolean        @default(false) // a Shopify development (test) store: only ever test charges, so it uses the app free
  crawlers          Json? // last AI crawler check of the store's robots.txt (see lib/robots.ts): which AI bots are blocked
  crawlersCheckedAt DateTime?
  reportEmails      String? // comma separated
  pixelId           String?
  costMonth         String? // "2026-10"
  costThisMonth     Float          @default(0)
  costAlertedAt     DateTime?
  source            String         @default("shopify") // shopify: installed from Shopify | web: added on the GEO web app
  userId            String? // web: the GEO account that added it
  trackKey          String?        @unique // web: the key in the store's tracking code (custom pixel), so only its own code can send orders
  user              User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  siteWriters       SiteWriter[]
  redditThreads     RedditThread[]
  supportFlags      SupportFlag[]
  redditCheckedAt   DateTime? // last weekly look for Reddit threads (lib/reddit.server.ts)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  profile     BrandProfile?
  products    Product[]
  questions   Question[]
  competitors Competitor[]
  scans       Scan[]
  snapshots   VisibilitySnapshot[]
  fixes       Fix[]
  outreach    OutreachTarget[]
  sessions    AiSession[]
  orders      AiOrder[]
  orderDays   OrderDay[]
  trafficDays TrafficDay[]
  jobs        Job[]
  costs       ApiCost[]

  @@index([userId, createdAt])
}

model BrandProfile {
  id         String   @id @default(cuid())
  shopId     String   @unique
  shop       Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  brandName  String
  aliases    Json     @default("[]") // other names the brand goes by
  summary    String // one paragraph: what they sell, who for
  category   String // e.g. "men's grooming"
  audience   String
  pricePoint String // budget | mid | premium
  country    String   @default("AU")
  updatedAt  DateTime @updatedAt
}

model Product {
  id          String    @id @default(cuid())
  shopId      String
  shop        Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  gid         String // gid://shopify/Product/123
  title       String
  handle      String
  productType String?
  vendor      String?
  tags        Json      @default("[]")
  description String?
  seoTitle    String?
  seoDesc     String?
  price       String?
  imageUrl    String?
  status      String?
  optimisedAt DateTime?
  syncedAt    DateTime  @default(now())

  @@unique([shopId, gid])
}

model Question {
  id        String   @id @default(cuid())
  shopId    String
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  text      String
  keyword   String? // short search-term form, used for volume lookup
  volume    Int?
  active    Boolean  @default(true)
  source    String   @default("ai") // ai | merchant
  cluster   String? // topic cluster label, e.g. "beard oil for sensitive skin" (guides are planned per cluster)
  longTail  Boolean  @default(false) // a specific, niche question (needs, ingredients, budget, gift, comparison)
  createdAt DateTime @default(now())

  answers AiAnswer[]

  @@unique([shopId, text])
}

model Competitor {
  id        String   @id @default(cuid())
  shopId    String
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  name      String // normalised display name
  domain    String?
  hidden    Boolean  @default(false) // merchant says "not a competitor"
  auto      Boolean  @default(true) // found by scan vs added by merchant
  createdAt DateTime @default(now())

  @@unique([shopId, name])
}

model Scan {
  id         String    @id @default(cuid())
  shopId     String
  shop       Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  kind       String // free | baseline | weekly | daily | manual
  status     String    @default("queued") // queued | running | done | failed
  engines    Json // ["chatgpt","gemini",...]
  runs       Int       @default(2)
  total      Int       @default(0)
  done       Int       @default(0)
  failed     Int       @default(0)
  score      Float?
  costUsd    Float     @default(0)
  error      String?
  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  answers  AiAnswer[]
  snapshot VisibilitySnapshot?

  @@index([shopId, startedAt])
}

model AiAnswer {
  id         String    @id @default(cuid())
  scanId     String
  scan       Scan      @relation(fields: [scanId], references: [id], onDelete: Cascade)
  questionId String
  question   Question  @relation(fields: [questionId], references: [id], onDelete: Cascade)
  engine     String // chatgpt | gemini | perplexity | aio | claude
  runNo      Int
  status     String    @default("pending") // pending | fetched | parsed | failed
  attempts   Int       @default(0)
  provider   String?
  text       String? // answer as markdown/plain text (trimmed)
  mentioned  Boolean   @default(false)
  position   Int? // merchant's rank among brands named (1 = first)
  costUsd    Float     @default(0)
  error      String?
  lockedAt   DateTime?
  createdAt  DateTime  @default(now())

  mentions  Mention[]
  citations Citation[]

  @@unique([scanId, questionId, engine, runNo])
  @@index([scanId, status])
}

model Mention {
  id         String   @id @default(cuid())
  answerId   String
  answer     AiAnswer @relation(fields: [answerId], references: [id], onDelete: Cascade)
  brand      String
  product    String?
  position   Int
  isMerchant Boolean  @default(false)

  @@index([answerId])
}

model Citation {
  id       String   @id @default(cuid())
  answerId String
  answer   AiAnswer @relation(fields: [answerId], references: [id], onDelete: Cascade)
  url      String
  domain   String
  title    String?
  type     String // retailer | editorial | ugc | brand | marketplace | other
  isOwn    Boolean  @default(false) // merchant's own site

  @@index([answerId])
}

model VisibilitySnapshot {
  id          String   @id @default(cuid())
  shopId      String
  shop        Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  scanId      String   @unique
  scan        Scan     @relation(fields: [scanId], references: [id], onDelete: Cascade)
  date        DateTime @default(now())
  score       Float
  byEngine    Json // { chatgpt: 40, gemini: 12 }
  mentionRate Float    @default(0) // share of answers that name the merchant (0-1)

  @@index([shopId, date])
}

model Fix {
  id          String    @id @default(cuid())
  shopId      String
  shop        Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  type        String // product_description | product_title | product_seo | product_faq | product_type | guide_page
  targetGid   String? // product gid (null for new pages)
  targetTitle String
  before      Json? // previous values, used for undo
  after       Json // new values to push
  reason      String
  impact      String    @default("medium") // high | medium | low
  questionIds Json      @default("[]")
  missingInfo String? // questions for the merchant instead of inventing facts
  status      String    @default("pending") // pending | applied | rejected | reverted | failed
  error       String?
  resultGid   String? // e.g. created page gid
  resultUrl   String?
  appliedAt   DateTime?
  revertedAt  DateTime?
  cluster     String? // guide pages: the topic cluster this page belongs to
  hubFixId    String? // guide pages: the cluster's hub guide this page links back to (null for the hub itself)
  refreshOfId String? // a refresh of an applied fix (freshness cycle): the fix it updates
  refreshedAt DateTime? // when this applied fix was last refreshed (or a refresh of it was applied)
  createdAt   DateTime  @default(now())

  @@index([shopId, status])
}

model OutreachTarget {
  id               String    @id @default(cuid())
  shopId           String
  shop             Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  url              String
  domain           String
  title            String?
  namedBrands      Json      @default("[]")
  timesCited       Int       @default(1)
  engines          Json      @default("[]")
  authorName       String?
  email            String?
  contactUrl       String?
  subject          String?
  pitch            String?
  status           String    @default("new") // new | drafted | sent | replied | won | skipped | named (the page already names the store)
  kind             String    @default("article") // article | video | forum | qa | directory | retailer | other
  mentionsMerchant Boolean? // the cited page itself names the store (null = not checked yet)
  pageCheckedAt    DateTime? // when we last read the cited page
  pageModifiedAt   DateTime? // the page's own published/updated date, when it gives one (fresher pages are better targets)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([shopId, url])
}

// Visits that came from an AI assistant (sent by the web pixel). No personal data.
model AiSession {
  id         String   @id @default(cuid())
  shopId     String
  shop       Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  engine     String // chatgpt | perplexity | gemini | copilot | claude | other_ai | ours
  referrer   String?
  landingUrl String?
  utmSource  String?
  clientKey  String? // hashed anonymous id, for de-duplication only
  occurredAt DateTime @default(now())

  @@unique([shopId, clientKey, landingUrl])
  @@index([shopId, occurredAt])
}

// All storefront visits per day (for "x% of visits came from AI").
model TrafficDay {
  id         String   @id @default(cuid())
  shopId     String
  shop       Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  date       DateTime @db.Date
  sessions   Int      @default(0)
  aiSessions Int      @default(0)

  @@unique([shopId, date])
}

model AiOrder {
  id        String   @id @default(cuid())
  shopId    String
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  orderGid  String
  orderName String?
  engine    String // chatgpt | perplexity | gemini | copilot | claude | other_ai | survey
  ours      Boolean  @default(false) // came through a page/link this app built
  reason    String // why we think it came from AI (shown in UI)
  revenue   Float
  currency  String
  products  Json     @default("[]") // [{title, qty}]
  orderedAt DateTime

  @@unique([shopId, orderGid])
  @@index([shopId, orderedAt])
}

// Every order per day (AI or not) so we can show AI as a share of sales.
model OrderDay {
  id      String   @id @default(cuid())
  shopId  String
  shop    Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  date    DateTime @db.Date
  orders  Int      @default(0)
  revenue Float    @default(0)

  @@unique([shopId, date])
}

// Simple background job queue. Jobs are idempotent and resumable.
model Job {
  id        String    @id @default(cuid())
  shopId    String?
  shop      Shop?     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  type      String
  payload   Json      @default("{}")
  status    String    @default("queued") // queued | running | done | failed
  attempts  Int       @default(0)
  runAfter  DateTime  @default(now())
  lockedAt  DateTime?
  error     String?
  dedupeKey String?   @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([status, runAfter])
  @@index([shopId, type, createdAt])
}

model ApiCost {
  id        String   @id @default(cuid())
  shopId    String?
  shop      Shop?    @relation(fields: [shopId], references: [id], onDelete: Cascade)
  provider  String // treg | anthropic | resend
  endpoint  String
  usd       Float
  createdAt DateTime @default(now())

  @@index([shopId, createdAt])
}

// A plan picked on the website before installing ("Start 7-day free trial" on a pricing card), by the
// store's myshopify domain. Offered on the dashboard once the free scan is done; deleted once used.
// Holds no personal data. Rows older than 30 days are ignored and cleared.
model PlanIntent {
  domain    String   @id // my-store.myshopify.com
  plan      String // core | pro
  cycle     String // monthly | yearly
  createdAt DateTime @default(now())
}

// People who joined the waitlist on the website (the home page popup). Not tied to a shop. One row per
// address: joining again updates the name and the last time. ipHash = HMAC of the IP, only to stop abuse.
// utm*/fbclid: where the visit came from (Meta ads), as sent in the page's address.
model WaitlistSignup {
  id          String   @id @default(cuid())
  email       String   @unique // lowercased
  name        String
  source      String // the button: hero, nav, pricing, footer, link
  plan        String? // core | pro, when joined from a pricing card
  cycle       String? // monthly | yearly, with plan
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  utmContent  String?
  utmTerm     String?
  fbclid      String?
  referrer    String?
  lang        String? // the home page language they joined on: en, de, fr, nl, es, it
  consentText String // the exact words shown under the form
  ipHash      String?
  joins       Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([ipHash, updatedAt])
}

// Free product check from the public home page (no install). Not tied to a shop.
// Deleted after 30 days (retention.server.ts). ipHash = sha256(ip + server secret), only to stop abuse.
model PublicCheck {
  id         String    @id @default(cuid())
  url        String
  country    String    @default("AU")
  status     String    @default("queued") // queued | reading | asking | writing | done | failed
  product    Json?
  questions  Json      @default("[]")
  answers    Json      @default("[]")
  report     Json?
  total      Int       @default(0)
  done       Int       @default(0)
  error      String?
  ipHash     String?
  createdAt  DateTime  @default(now())
  finishedAt DateTime?

  @@index([url, country, createdAt])
  @@index([ipHash, createdAt])
  @@index([createdAt])
}

// Someone who asked for the free check's full report by email. One row per address. Asking for a report
// is not a newsletter sign-up: tips go only to people who ticked the box (tipsConsentAt) and then clicked
// "Yes, keep sending me tips" in the report email (tipsConfirmedAt), and who haven't unsubscribed since
// (see tipsListWhere in check-lead.server.ts). A form post never clears unsubscribedAt; only that
// confirmation click from the inbox can. Kept until 30 days after unsubscribing, or 24 months after the
// last request or click (retention.server.ts), then deleted with its ReportEmail rows.
model Subscriber {
  id               String    @id @default(cuid())
  email            String    @unique // lowercased
  source           String    @default("free-check")
  consentText      String // the exact words shown with the email form on the first request
  consentAt        DateTime // the first request
  consentCheckId   String? // the check that first request was for
  tipsConsentText  String? // the exact words of the tips box, when ticked
  tipsConsentAt    DateTime? // when the tips box was last ticked
  tipsCheckId      String? // the check page it was ticked on
  tipsConfirmedAt  DateTime? // "Yes, keep sending me tips" clicked in the report email
  lastActiveAt     DateTime  @default(now()) // last request or click, for the 24-month clean-up
  unsubscribedAt   DateTime?
  unsubscribeToken String    @unique // random, in every email's unsubscribe and confirm links
  createdAt        DateTime  @default(now())
}

// Addresses that unsubscribed and were then deleted, kept only as a hash (no address), so a later import
// or tips send can never email them again by mistake. Never deleted.
model EmailSuppression {
  emailHash String   @id // sha256 of "geo:suppress:" + the lowercased address (see suppressionHash)
  createdAt DateTime @default(now())
}

// One emailed copy of a free check's report (PDF attached). Sent by the "check.email" job once the
// check is done. Deleted after 90 days, or with its Subscriber. ipHash = HMAC of the IP (cleared after a
// day), only for limits.
model ReportEmail {
  id        String    @id @default(cuid())
  email     String // lowercased
  checkId   String // PublicCheck id (no foreign key: checks are deleted after 30 days, these after 90)
  status    String    @default("pending") // pending | sending (a worker is sending it) | sent | failed | skipped
  attempts  Int       @default(0)
  error     String?
  sentAt    DateTime?
  lockedAt  DateTime? // when a worker claimed it ("sending"); a claim older than 10 minutes goes back to pending
  ipHash    String?
  createdAt DateTime  @default(now())

  @@index([checkId])
  @@index([ipHash, createdAt])
  @@index([email, createdAt])
  @@index([createdAt])
}

// GEO web app accounts (usegeo.app/login). Sign in by email link only: no passwords.
model User {
  id          String    @id @default(cuid())
  email       String    @unique // lowercased
  createdAt   DateTime  @default(now())
  lastLoginAt DateTime?
  shops       Shop[]
}

// One sign-in link. Only a hash of the token is kept; a link works once, for 30 minutes.
model LoginLink {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  email     String
  next      String? // where to go after signing in
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email, createdAt])
}

// Sites AI trusts: the writer behind a site AI cites for the store, looked up once per site (Treg author finder).
// found = false: we looked and found nobody (still counted, so lookups can't run up costs).
model SiteWriter {
  id        String   @id @default(cuid())
  shopId    String
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  domain    String
  pageUrl   String
  pageTitle String?
  found     Boolean  @default(false)
  name      String?
  position  String?
  company   String?
  email     String?
  linkedin  String?
  twitter   String?
  createdAt DateTime @default(now())

  @@unique([shopId, domain])
  @@index([shopId, createdAt])
}

/// Reddit finder: a thread where a buyer asks about the store's kind of product, and the reply we drafted for the
/// owner to post themselves (status: new | replied | hidden).
model RedditThread {
  id        String    @id @default(cuid())
  shopId    String
  shop      Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  postId    String
  url       String
  subreddit String
  title     String
  body      String?
  author    String?
  score     Int       @default(0)
  comments  Int       @default(0)
  postedAt  DateTime?
  query     String?
  draft     String?
  status    String    @default("new")
  repliedAt DateTime?
  createdAt DateTime  @default(now())

  @@unique([shopId, postId])
  @@index([shopId, createdAt])
}

/// Ask GEO: a question the help chat passed to the GEO team (status: open | done). Only a short summary is kept,
/// never the chat itself.
model SupportFlag {
  id        String   @id @default(cuid())
  userId    String?
  shopId    String?
  shop      Shop?    @relation(fields: [shopId], references: [id], onDelete: Cascade)
  email     String
  reason    String
  summary   String
  status    String   @default("open")
  createdAt DateTime @default(now())

  @@index([status, createdAt])
}
