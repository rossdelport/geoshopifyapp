{%- comment -%}
  Product FAQs written and approved in the GEO app (saved in the product metafield geo.faq).
  Also adds FAQPage structured data, which helps search engines and AI assistants read them.
{%- endcomment -%}
{%- assign faq = product.metafields.geo.faq.value -%}
{%- if faq and faq.size > 0 -%}
  <div class="geo-faq" style="margin: 2rem 0;">
    <h2 class="geo-faq__heading">
      {%- if block.settings.heading != blank -%}{{ block.settings.heading | escape }}{%- else -%}{{ 'faq.heading' | t }}{%- endif -%}
    </h2>
    {%- for item in faq -%}
      <details class="geo-faq__item" style="border-top: 1px solid rgba(0,0,0,.1); padding: .75rem 0;">
        <summary style="cursor: pointer; font-weight: 600;">{{ item.q | escape }}</summary>
        <div style="margin-top: .5rem;">{{ item.a | escape | newline_to_br }}</div>
      </details>
    {%- endfor -%}
  </div>
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {%- for item in faq -%}
          {
            "@type": "Question",
            "name": {{ item.q | json }},
            "acceptedAnswer": { "@type": "Answer", "text": {{ item.a | json }} }
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    }
  </script>
{%- endif -%}

{% schema %}
{
  "name": "AI-ready FAQs",
  "target": "section",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Questions & answers" }
  ]
}
{% endschema %}
