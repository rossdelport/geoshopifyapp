# Copy to .env and fill in. Never commit .env.
# Database: Supabase "OneInbox" project, "geo" schema only (login: geo_app).
# Pooler host from Supabase > OneInbox > Connect > Direct > Session pooler.
# In production the server talks to the database through DIRECT_URL (the session pooler, at most 6 connections):
# a query is one round trip (75 ms from Railway) instead of about five through DATABASE_URL (365 ms). Tests and
# local runs use DATABASE_URL. Set DB_USE_TRANSACTION_POOLER=true to switch production back. See db.server.ts.
DATABASE_URL="postgresql://geo_app.afkgkmhshitfopddadbr:PASSWORD@aws-1-ap-northeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&schema=geo"
DIRECT_URL="postgresql://geo_app.afkgkmhshitfopddadbr:PASSWORD@aws-1-ap-northeast-1.pooler.supabase.com:5432/postgres?schema=geo"

# Email (Resend): monthly reports, operator alerts and free check reports. Before turning on free check
# emails, send from a GEO-owned domain (its own Resend domain), not another business's sender.
RESEND_API_KEY=""
GEO_EMAIL_FROM=""
# Who is emailed about each new waitlist signup, each new store, and stores starting or leaving Done-for-you.
GEO_ALERT_EMAIL=""
# Contact address shown on /privacy and used as the listing's support email.
SUPPORT_EMAIL=""
# "false" at launch. Anything else (or unset) makes every subscription a test charge.
SHOPIFY_BILLING_TEST="true"

# Free product check (public website).
# Scrambles visitors' IPs for the daily limits and signs the "email me the report" cookie. Set a long
# random value on Railway, otherwise limits and cookies reset on every deploy.
CHECK_IP_SECRET=""
# The app's public address: report emails link back to it (unsubscribe, the report, the free trial).
SHOPIFY_APP_URL=""
# Most free check report emails in 24 hours (default 100; 0 turns them off).
GEO_REPORT_EMAILS_PER_DAY="100"
# Where replies to report emails go (default: SUPPORT_EMAIL, then the GEO_EMAIL_FROM address).
GEO_REPLY_TO=""
# Who sends the emails (Spam Act, CAN-SPAM, CASL): shown in every report email's footer and on /privacy.
# GEO is a working name, so set the business's legal name, ABN and a postal address (a PO box is fine).
GEO_LEGAL_NAME=""
GEO_ABN=""
GEO_POSTAL_ADDRESS=""
